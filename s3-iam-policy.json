{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowInvoiceObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_SHARED_BUCKET/tesla-invoices/*"
    },
    {
      "Sid": "DenyS3OutsideInvoicePrefix",
      "Effect": "Deny",
      "Action": "s3:*",
      "NotResource": "arn:aws:s3:::REPLACE_WITH_SHARED_BUCKET/tesla-invoices/*"
    },
    {
      "Sid": "DenyOtherOperationsOnInvoiceObjects",
      "Effect": "Deny",
      "NotAction": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_SHARED_BUCKET/tesla-invoices/*"
    }
  ]
}
